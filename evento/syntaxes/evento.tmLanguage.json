{
    "name": "evento",
    "scopeName": "source.evento",
    "fileTypes": [
        ".e",
        ".i"
    ],
    "patterns": [
        {
            "include": "#comments"
        },
        {
            "include": "#numeric"
        },
        {
            "include": "#types"
        },
        {
            "include": "#string"
        },
        {
            "name": "keyword.control.evento",
            "match": "\\b(const|extern|fn|let|mut)\\b",
            "comment": "Evento keywords"
        }
    ],
    "repository": {
        "types": {
            "patterns": [
                {
                    "name": "constant.language.boolean.evento",
                    "match": "\\b(true|false)\\b",
                    "comment": "Boolean literals"
                },
                {
                    "name": "constant.language.symbol.evento",
                    "match": "\\#[a-zA-Z_][a-zA-Z0-9_]*\\b",
                    "comment": "Symbol literals"
                },
                {
                    "name": "storage.type.numeric.evento",
                    "match": "`[ui](8|16|32|64|[0-9]+)\\b",
                    "comment": "Integer type suffixes"
                },
                {
                    "name": "storage.type.float.evento",
                    "match": "`f(16|32|64)\\b",
                    "comment": "Float type suffixes"
                }
            ]
        },
        "string": {
            "patterns": [
                {
                    "name": "string.quoted.single.evento",
                    "begin": "'",
                    "end": "'",
                    "comment": "single-quoted string"
                },
                {
                    "name": "string.quoted.double.evento",
                    "begin": "\"",
                    "end": "\"",
                    "comment": "double-quoted string"
                }
            ]
        },
        "numeric": {
            "patterns": [
                {
                    "name": "constant.numeric.integer.decimal.evento",
                    "match": "\\b[+-]?[0-9][0-9_]*\\b",
                    "comment": "Decimal integers"
                },
                {
                    "name": "constant.numeric.integer.hex.evento",
                    "match": "\\b0x[0-9a-fA-F][0-9a-fA-F_]*\\b",
                    "comment": "Hexadecimal literals"
                },
                {
                    "name": "constant.numeric.integer.octal.evento",
                    "match": "\\b0o[0-7][0-7_]*\\b",
                    "comment": "Octal literals"
                },
                {
                    "name": "constant.numeric.integer.binary.evento",
                    "match": "\\b0b[01][01_]*\\b",
                    "comment": "Binary literals"
                },
                {
                    "name": "constant.numeric.float.evento",
                    "match": "\\b[+-]?([0-9]+\\.[0-9]+|\\.[0-9]+)([eE][+-]?[0-9]+)?\\b",
                    "comment": "Floating point numbers"
                }
            ]
        },
        "comments": {
            "patterns": [
                {
                    "begin": "#!",
                    "end": "(?=$)",
                    "name": "comment.line.evento",
                    "comment": "shebang script header"
                },
                {
                    "name": "comment.line.evento",
                    "comment": "Line comments",
                    "begin": "//",
                    "end": "(?=$)"
                },
                {
                    "name": "comment.block.evento",
                    "comment": "Block comments",
                    "begin": "/\\*",
                    "beginCaptures": {
                        "0": {
                            "name": "punctuation.definition.comment.evento"
                        }
                    },
                    "end": "\\*/",
                    "endCaptures": {
                        "0": {
                            "name": "punctuation.definition.comment.evento"
                        }
                    }
                }
            ]
        }
    }
}
