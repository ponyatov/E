{
    "name": "evento",
    "displayName": "Evento",
    "description": "embedded programming language prototype",
    "version": "0.0.1",
    "author": "Dmitry Ponyatov <dponyatov@gmail.com>",
    "license": "MIT",
    "scripts": {
        "test": "echo \"Error: no test specified\" && exit 1"
    },
    "dependencies": {
    },
    "devDependencies": {
        "@types/node": "^18.0.0",
        "typescript": "~5.8.3"
    },
    "engines": {
        "vscode": "^1.67.0",
        "node": ">=18.0.0"
    },
    "categories": [
        "Programming Languages"
    ],
    "contributes": {
        "languages": [
            {
                "id": "evento",
                "aliases": ["Evento","evento"],
                "extensions": [".e",".i"],
                "configuration": "./language-configuration.json"
            }
        ],
        "grammars": [
            {
                "language": "evento",
                "scopeName": "source.evento",
                "path": "./evento.tmLanguage.json"
            }
        ]
    },
    "activationEvents": [
        "onLanguage:evento"
    ],
    "publisher": "dponyatov",
    "icon": "./logo.png",
    "main": "./index.js"
}
